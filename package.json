    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@protomaps/basemaps": "^5.7.2",
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toast": "1.3.1",
    "@tabler/icons-react": "3.50.0",
    "@tailwindcss/postcss": "4.3.4",
    "@tanstack/react-query": "5.106.1",
    "@types/sanitize-html": "^2.16.2",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "aws4fetch": "^1.0.20",
    "axios": "^1.21.0",
    "better-auth": "^1.7.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "fabric": "^7.4.0",
    "feed": "^6.0.0",
    "i18next": "26.7.2",
    "i18next-browser-languagedetector": "^8.3.0",
    "lucide-react": "1.70.0",
    "maplibre-gl": "^6.16.0",
    "marked": "18.1.3",
    "nanoid": "^6.0.2",
    "next-themes": "^0.4.6",
    "peggy": "^5.1.1",
    "pigeon-maps": "^0.22.1",
    "pmtiles": "^4.5.0",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "7.91.0",
    "react-i18next": "17.1.13",
    "react-is": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-qr-code": "^2.2.0",
    "recharts": "3.10.1",
    "sanitize-html": "^2.18.1",
    "stripe": "22.6.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "4.3.4",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1163.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.6.0",
    "@cloudflare/vite-plugin": "1.67.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@electric-sql/pglite": "^0.5.15",
    "@kartore/glyphore": "^0.2.0",
    "@noble/ciphers": "2.1.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-is": "^19",
    "@types/ws": "^8.18.2",
    "@vinext/cloudflare": "1.3.3",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitejs/plugin-rsc": "0.5.39",
    "dotenv": "^17.4.2",
    "eslint": "10.14.0",
