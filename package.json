{
  "name": "panamia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:encrypted": "CHAT_E2EE_ENABLED=1 vinext build",
    "start": "vinext start",
    "lint": "eslint .",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "test:relay": "node --import tsx --test tests-relay/*.test.ts",
    "test:unit": "node --import tsx --test tests-unit/*.test.ts",
    "test:db": "node --experimental-test-module-mocks --import tsx --test --test-concurrency=1 tests-db/*.test.ts",
    "e2ee:lab": "vite --config vite.e2ee.config.ts",
    "e2ee:api-lab": "node --experimental-test-module-mocks --import tsx prototypes/e2ee/api-server.ts",
    "openmls:build": "node --import tsx scripts/openmls.ts build",
    "openmls:check": "node --import tsx scripts/openmls.ts check",
    "openmls:audit": "node --import tsx scripts/openmls.ts audit",
    "test:openmls:rust": "node --import tsx scripts/openmls.ts test",
    "test:openmls": "node --import tsx --test tests-openmls/*.test.ts",
    "test:e2ee": "node --import tsx --test tests-unit/e2ee-*.test.ts",
    "test:e2ee:browser": "playwright test --config playwright.e2ee.config.ts",
    "test:e2ee:native": "node --import tsx scripts/qualify-native-e2ee.ts",
    "test:db:visibility": "node --experimental-test-module-mocks --import tsx --test tests-db/visibility.test.ts tests-db/mixed-feed.test.ts tests-db/feed-page.test.ts tests-db/post-composer.test.ts tests-db/local-actors.test.ts tests-db/social-activation.test.ts tests-db/group-chat.test.ts",
    "prepare": "husky && (git remote get-url activities-upstream 2>/dev/null || git remote add activities-upstream https://github.com/llun/activities.next.git)",
    "subtree:pull": "git subtree pull --prefix=external/activities.next activities-upstream main --squash",
    "env:check": "npx tsx scripts/env-check.ts check",
    "env:wrangler": "npx tsx scripts/env-check.ts wrangler",
    "env:workflow": "npx tsx scripts/env-check.ts workflow",
    "env:list": "npx tsx scripts/env-check.ts list",
    "env:secrets": "npx tsx scripts/env-check.ts secrets",
    "env:vars": "npx tsx scripts/env-check.ts vars",
    "check:privacy-schema": "npx tsx scripts/check-data-inventory.ts",
    "db:reset": "npx tsx scripts/reset-test-db.ts",
    "db:seed": "npx tsx scripts/seed-dev-data.ts && npx tsx scripts/seed-test-account.ts && npx tsx scripts/seed-events.ts",
    "db:unseed": "npx tsx scripts/unseed.ts",
    "db:demo:events": "npx tsx scripts/seed-real-events.ts",
    "db:demo:events:undo": "npx tsx scripts/seed-real-events.ts --undo",
    "db:photos": "npx tsx scripts/seed-business-photos.ts",
    "photos:fetch": "npx tsx scripts/fetch-directory-photos.ts",
    "db:studio": "drizzle-kit studio",
    "db:migrate-region": "npx tsx scripts/migrate-supabase-region.ts",
    "db:generate": "echo 'This project hand-writes migrations under drizzle/. The drizzle-kit snapshot is intentionally stale (see drizzle.config.ts). If you really need to run drizzle-kit generate, invoke it directly with: npx drizzle-kit generate' && exit 1",
    "db:migrate": "drizzle-kit migrate",
    "db:check-pending": "npx tsx scripts/check-pending-migrations.ts",
    "dev:setup": "npx tsx scripts/setup-dev-vars.ts",
    "dev:vinext": "vinext dev --port 3001",
    "dev:http": "vinext dev --host 0.0.0.0 --port 3000",
    "build:vinext": "vinext build",
    "deploy:vinext": "drizzle-kit migrate && vinext-cloudflare deploy",
    "mobile": "npx tsx scripts/mobile-run.ts",
    "mobile:sync": "cap sync",
    "mobile:assets": "npx tsx scripts/mobile-assets.ts",
    "mobile:doctor": "cap doctor",
    "mobile:open:android": "cap open android",
    "mobile:open:ios": "cap open ios",
    "mobile:run:android": "npx tsx scripts/mobile-run.ts",
    "mobile:bundle:android": "npx tsx scripts/android-bundle.ts",
    "mobile:bundle:ios": "npx tsx scripts/ios-bundle.ts",
    "mobile:sideload:ios": "npx tsx scripts/ios-sideload.ts",
    "mobile:run:ios": "cap run ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
